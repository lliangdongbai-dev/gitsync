# GitSync Environment Configuration
# Copy this file to .env and modify the values

# Server port
PORT=3001

# Database path (SQLite)
DB_PATH=./data/gitsync.db

# Repository storage directory
REPO_DIR=./data/repos

# SSH key storage directory
SSH_KEY_DIR=./data/ssh_keys

# Basic Authentication (leave empty to disable)
AUTH_USER=
AUTH_PASS=

# Log retention days (sync logs older than this will be auto-deleted)
LOG_RETENTION_DAYS=7

# Encryption key for storing tokens (leave empty to store in plaintext)
# Set a 32-character string for AES-256-CBC encryption
ENCRYPTION_KEY=
